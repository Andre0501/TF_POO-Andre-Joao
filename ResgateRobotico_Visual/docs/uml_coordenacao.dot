digraph UML {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.55];
node [shape=plain, fontname="DejaVu Sans", fontsize=16];
edge [fontname="DejaVu Sans", fontsize=13, color="#465364"];
C [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#edf1f5"><B>CentralResgate</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- nome: String</TD></TR><TR><TD ALIGN="LEFT">- robos: Map&lt;String, Robo&gt;</TD></TR><TR><TD ALIGN="LEFT">- areas: Map&lt;String, AreaOperacao&gt;</TD></TR><TR><TD ALIGN="LEFT">- missoes: Map&lt;String, Missao&gt;</TD></TR><TR><TD ALIGN="LEFT">- missoesPendentes: Queue&lt;Missao&gt;</TD></TR><TR><TD ALIGN="LEFT">- historicoOperacoes: List&lt;String&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT">+ cadastrarRobo(Robo): void</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarArea(AreaOperacao): void</TD></TR><TR><TD ALIGN="LEFT">+ registrarMissao(Missao): void</TD></TR><TR><TD ALIGN="LEFT">+ listarRobosDisponiveis(): List&lt;Robo&gt;</TD></TR><TR><TD ALIGN="LEFT">+ atribuirRoboMissao(String, String): void</TD></TR><TR><TD ALIGN="LEFT">+ listarMissoesPendentes(): List&lt;Missao&gt;</TD></TR><TR><TD ALIGN="LEFT">+ executarMissao(String): void</TD></TR><TR><TD ALIGN="LEFT">+ gerarRelatorioGeral(): Relatorio</TD></TR></TABLE>>];
M [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#edf1f5"><B>Missao</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id, descricao: String</TD></TR><TR><TD ALIGN="LEFT">- tipo: TipoMissao</TD></TR><TR><TD ALIGN="LEFT">- area: AreaOperacao</TD></TR><TR><TD ALIGN="LEFT">- prioridade: PrioridadeMissao</TD></TR><TR><TD ALIGN="LEFT">- status: StatusMissao</TD></TR><TR><TD ALIGN="LEFT">- roboResponsavel: Robo</TD></TR><TR><TD ALIGN="LEFT">- resultado: String</TD></TR><TR><TD ALIGN="LEFT">- pesoSuprimentos: int</TD></TR><TR><TD ALIGN="LEFT">- consumoPrevisto, consumoAplicado: int</TD></TR><HR/><TR><TD ALIGN="LEFT">+ atribuirRobo(Robo): void</TD></TR><TR><TD ALIGN="LEFT">+ iniciar(): void</TD></TR><TR><TD ALIGN="LEFT">+ concluir(String): void</TD></TR><TR><TD ALIGN="LEFT">+ cancelar(): void</TD></TR><TR><TD ALIGN="LEFT">+ removerRobo(): void</TD></TR><TR><TD ALIGN="LEFT">+ exibirResumo(): String</TD></TR></TABLE>>];
A [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#edf1f5"><B>AreaOperacao</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id, nome: String</TD></TR><TR><TD ALIGN="LEFT">- localizacao, descricao: String</TD></TR><TR><TD ALIGN="LEFT">- tipoTerreno: TipoTerreno</TD></TR><TR><TD ALIGN="LEFT">- nivelRisco: NivelRisco</TD></TR><HR/><TR><TD ALIGN="LEFT">+ atualizarNivelRisco(NivelRisco): void</TD></TR><TR><TD ALIGN="LEFT">+ exibirInformacoes(): String</TD></TR></TABLE>>];
C -> M [dir=both,arrowtail=odiamond,arrowhead=none,taillabel="1",headlabel="0..*",label="registra e enfileira"];
C -> A [dir=both,arrowtail=odiamond,arrowhead=none,taillabel="1",headlabel="0..*",label="cadastra"];
M -> A [taillabel="0..*",headlabel="1",label="ocorre em",constraint=false];
{rank=same;M;A;}
}